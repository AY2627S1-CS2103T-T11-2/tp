<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane id="commandBox" styleClass="command-shell" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <HBox alignment="CENTER_LEFT" spacing="14">
    <Label text="»" styleClass="command-symbol" />
    <TextField fx:id="commandTextField" minWidth="0" HBox.hgrow="ALWAYS" onAction="#handleCommandEntered" onKeyPressed="#handleHistoryNavigation" promptText="Enter a command... (e.g. list, help...)" />
    <Label fx:id="commandPosition" styleClass="command-position" />
  </HBox>
</StackPane>
