@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class Person
Class TelegramHandle
Class Email
Class Name
Class Phone
Class Subject
Class Group
Class Tag

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniquePersonList
UniquePersonList --> "~* all" Person
Person *--> "1" Name
Person *--> "1" Phone
Person *--> "1" Email
Person *--> "1" TelegramHandle
Person *--> "1" Subject
Person *--> "1" Group
Person *--> "*" Tag

note left of Name
  Stores a normalized, non-blank name.
  Alphanumeric words are separated by single
  spaces, hyphens, or apostrophes.
end note

note right of TelegramHandle
  Stores an optional Telegram handle.
  Non-empty values begin with @, followed by
  5 to 32 letters, digits, or underscores.
  The first character after @ is not an underscore.
end note

note right of Phone
  Optional phone number.
  An empty value represents no phone number.
  Spaces and hyphens are removed when constructed;
  an optional leading + is retained.
end note

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> TelegramHandle
TelegramHandle -[hidden]right-> Email

ModelManager --> "~* filtered" Person
@enduml
