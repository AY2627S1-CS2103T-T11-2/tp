@startuml
!include style.puml
skinparam ArrowFontStyle plain
hide footbox

box Logic LOGIC_COLOR_T1
participant "command:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "target:IndexPersonTarget" as IndexPersonTarget LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "model:Model" as Model MODEL_COLOR
end box

[-> DeleteCommand ++: execute(model)
DeleteCommand -> IndexPersonTarget ++: resolve(model)
IndexPersonTarget -> Model ++: getFilteredPersonList()
Model --> IndexPersonTarget --: displayedPeople
note right of IndexPersonTarget
  Validate all indexes against
  the same displayed-list snapshot.

  Resolve duplicate and overlapping
  ranges only once.
end note
IndexPersonTarget --> DeleteCommand --: peopleToDelete

DeleteCommand -> Model ++: deletePersonsInBatch(peopleToDelete)
Model --> DeleteCommand --
DeleteCommand -> DeleteCommand : prepare success CommandResult
DeleteCommand -> Model ++: updateFilteredPersonList(showAllPredicate)
Model --> DeleteCommand --

note over DeleteCommand, Model
  The batch deletion updates the observable list once.
  A successful whole-person deletion resets the filter.
end note

[<-- DeleteCommand --: CommandResult
@enduml
